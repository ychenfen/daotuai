# 复制成 .env 后按需填写。系统环境变量里已有的值优先（纪总电脑上 ARK / DASHSCOPE / DEEPSEEK 已经配在系统里）。

# ---------- 真实渠道 key（有 key 的渠道才会真实调用、真实扣费） ----------
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# ARK_API_KEY=

# ---------- 安全开关 ----------
# 1 = 所有渠道一律走模拟（不花钱）；演示、培训、调流程时打开
# AGG_FORCE_MOCK=0

# ---------- 工作流默认值（每个项目还能在“设置”页单独改） ----------
# WORKFLOW_TEXT_MODEL=deepseek-chat
# WORKFLOW_IMAGE_MODEL=seedream-5.0-flash
# WORKFLOW_VIDEO_MODEL=ark-seedance-2.0-fast   # 需先在火山方舟控制台开通
# WORKFLOW_RESOLUTION=480P
# WORKFLOW_BUDGET_RMB=50
# auto=先调模型、失败退回本地规则；real=只用模型；mock=只用本地规则
# WORKFLOW_LLM=auto

# ---------- 其他 ----------
# 访问上游下载视频/图片时用的代理（一般不用）
# WORKFLOW_PROXY=http://127.0.0.1:7890
# AGG_PROXY=http://127.0.0.1:7890
# ffmpeg 不在 PATH 时指定
# FFMPEG=C:\path\to\ffmpeg.exe
